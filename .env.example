# ============================================================
# CALORIEBOT CONFIGURATION (.env)
# ============================================================

# 1. Telegram Bot Token
# Get free instantly from @BotFather on Telegram (search @BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=

# 2. Google Gemini API Key
# Get free instantly from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3. User Target Profile (Male, 21 y/o, 168 cm, 89kg -> 70kg cut)
USER_NAME=Champion
USER_AGE=21
USER_GENDER=male
USER_HEIGHT_CM=168.0
USER_CURRENT_WEIGHT_KG=89.0
USER_TARGET_WEIGHT_KG=70.0

# 4. Daily Nutrition Budget
# Mifflin-St Jeor BMR = 1,840 kcal. Maintenance = 2,208 kcal.
# 500 kcal daily deficit target = 1,750 kcal/day (safe -19 kg fat cut)
DAILY_CALORIE_BUDGET=1750
DAILY_PROTEIN_TARGET_G=120

# 5. Server
HOST=0.0.0.0
PORT=8000
